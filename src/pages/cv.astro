---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import {
  summary,
  roles,
  additionalExperience,
  education,
  skills,
  certifications,
  interests,
} from '../data/cv';
import { cvFileBase } from '../data/cv-filename.mjs';
import { existsSync } from 'node:fs';

const hasPortrait = existsSync('public/images/veronica.webp');
---

<Base title={`Curriculum vitae - ${site.name}`}>
  <div class="wrap cv-shell">
    <div class="cv-topline">
      <div class="download-actions">
        <a class="button" href={`/${cvFileBase}.pdf`} download>
          Download PDF <Arrow direction="down" />
        </a>
        <a class="text-link" href={`/${cvFileBase}.docx`} download>
          Word document <Arrow direction="down" />
        </a>
      </div>
    </div>
    <header class:list={['cv-header', { 'cv-header-with-photo': hasPortrait }]}>
      {hasPortrait && (
        <img
          class="cv-photo"
          src="/images/veronica-400.webp"
          alt="Veronica Kurteva"
          width="400"
          height="400"
        />
      )}
      <div class="cv-identity">
        <h1>{site.name}</h1>
        <p class="cv-role">{site.role}</p>
        <p class="cv-contact">
          {site.location}
          <span aria-hidden="true"> · </span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span aria-hidden="true"> · </span>
          <a href={site.linkedin}>LinkedIn</a>
        </p>
      </div>
      <p class="cv-summary">{summary}</p>
    </header>
    <section class="cv-section" id="experience" aria-labelledby="cv-experience">
      <h2 id="cv-experience">Technical experience</h2>
      <div>
        {roles.map((role) => (
          <article class="cv-employer">
            <h3>{role.company}</h3>
            <p class="cv-location">{role.location}</p>
            {role.positions.map((position) => (
              <div class="cv-position">
                <div class="cv-entry-title">
                  <h4>{position.title}</h4>
                  <p>{position.period}</p>
                </div>
                {position.bullets.length > 0 && (
                  <ul>
                    {position.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
                {position.tech && (
                  <ul class="tech-labels" aria-label="Technologies">
                    {position.tech.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </article>
        ))}
      </div>
    </section>
    <section class="cv-section" aria-labelledby="cv-education">
      <h2 id="cv-education">Education</h2>
      <div>
        {education.map((item) => (
          <article class="cv-education">
            <div class="cv-entry-title">
              <h3>{item.degree}</h3>
              <p>{item.period}</p>
            </div>
            <p>{item.school}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="cv-section" aria-labelledby="cv-skills">
      <h2 id="cv-skills">Technical skills</h2>
      <dl class="cv-skills">
        {skills.map((group) => (
          <div>
            <dt>{group.group}</dt>
            <dd>{group.items.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </section>
    <section class="cv-section" aria-labelledby="cv-additional">
      <h2 id="cv-additional">Additional experience</h2>
      <div>
        {additionalExperience.map((role) => (
          <article class="cv-employer">
            <h3>{role.company}</h3>
            <p class="cv-location">{role.location}</p>
            {role.positions.map((position) => (
              <div class="cv-position">
                <div class="cv-entry-title">
                  <h4>{position.title}</h4>
                  <p>{position.period}</p>
                </div>
                <ul>
                  {position.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))}
      </div>
    </section>
    <section class="cv-section" aria-labelledby="cv-certifications">
      <h2 id="cv-certifications">Certifications & training</h2>
      <ul>
        {certifications.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
    <section class="cv-section" aria-labelledby="cv-interests">
      <h2 id="cv-interests">Interests</h2>
      <p>{interests.join(' · ')}</p>
    </section>
  </div>
</Base>
