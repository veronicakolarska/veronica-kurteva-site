---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import { education, interests, roles } from '../data/cv';
import {
  companySpan,
  earlier,
  firstYear,
  presentMonth,
  studyItems,
  timeline,
  totalMonths,
  workLanes,
  years,
} from '../data/timeline';
const hasPortrait = existsSync('public/images/veronica.webp');
const recentRoles = roles.slice(0, 3).map((role) => ({
  ...role,
  ...companySpan(role),
  // Job titles at this employer, current first, so a promotion stacks above the earlier role.
  titles: role.positions.map((position) => position.title),
  // Every technology used at this employer, newest position first, without repeats.
  tech: [...new Set(role.positions.flatMap((position) => position.tech ?? []))],
}));
// Labels near the right edge hang leftwards so they stay inside the column.
const anchorEnd = (start: number) => start > totalMonths - 28;
// One sentence for everything that ended before the chart begins.
const earlierParts = earlier.map((item) =>
  item.row === 'work'
    ? `${item.title.toLowerCase()} at ${item.org} (${item.period})`
    : `a ${item.title.replace('’s degree, ', '’s in ')} (${item.period})`,
);
const earlierSentence =
  earlierParts.length > 1
    ? `${earlierParts.slice(0, -1).join(', ')} and ${earlierParts.at(-1)}`
    : earlierParts.join('');
---

<Base>
  <section
    class:list={['hero', 'wrap', { 'hero-with-portrait': hasPortrait }]}
    aria-labelledby="intro-title"
  >
    <div class="hero-copy">
      <h1 id="intro-title">
        <span class="hero-line">I build .NET backends.</span>
        <em class="hero-line">I study how people think.</em>
      </h1>
    </div>
    <div class="hero-side">
      <p class="hero-intro">
        I’m Veronica, a backend developer at EGT Digital in Sofia, building microservices on the
        .NET stack. Alongside that I’m doing a master’s in cognitive science, exploring human–AI
        collaboration, something I see firsthand in my daily work.
      </p>
      <div class="hero-actions">
        <a class="button" href={`mailto:${site.email}`}>
          Email me <Arrow direction="out" />
        </a>
        <a class="text-link" href="/cv/">
          Read my CV <Arrow />
        </a>
      </div>
    </div>
    {hasPortrait && (
      <figure class="portrait">
        <img
          src="/images/veronica.webp"
          srcset="/images/veronica-400.webp 400w, /images/veronica-600.webp 600w, /images/veronica.webp 800w"
          sizes="(min-width: 1200px) 395px, (min-width: 721px) 33vw, 72vw"
          alt="Veronica Kurteva"
          width="640"
          height="800"
          fetchpriority="high"
        />
      </figure>
    )}
  </section>

  <section class="about-section" aria-labelledby="about-title">
    <div class="wrap section-grid">
      <h2 id="about-title">Five years of building and running production .NET services.</h2>
      <div class="prose">
        <p>
          I came to software by a slightly roundabout route. My first job was in a data centre,
          monitoring infrastructure and fixing server and network problems, sometimes literally
          splicing the fibre. From there I moved into C# for industrial machines at Sensata, then
          backend work at MentorMate and Accedia, where I moved older applications onto ASP.NET
          Core. These days I’m at EGT Digital, building the microservices that send messages to
          players across several iGaming brands.
        </p>
        <p>
          I’m happiest when a service just works and nobody has to think about it. Getting there is
          the fun part: reworking our Redis caching cut database load by 20%, and I’ll gladly spend
          an afternoon in the logs, Grafana and Kibana until a strange production bug finally makes
          sense. I’ve also mentored two junior developers, which I really enjoyed.
        </p>
        <p>
          Computer Science was my first degree. While working as a developer, curiosity about how
          people think sent me back to university for Cognitive Science and Psychology, and now I’m
          doing a master’s in Cognitive Science, looking at how people decide how far to rely on AI
          tools. It turns out to be a very practical question when you use them every day.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section-space" aria-labelledby="timeline-title">
    <div class="section-heading">
      <h2 id="timeline-title">My path to backend development.</h2>
      <p class="section-note">
        <span class="swatch swatch-cognition"></span> Terracotta marks the psychology.
      </p>
    </div>
    <ol
      class="timeline"
      style={`--months: ${totalMonths}`}
      aria-label="Work and study, 2014 to today"
    >
      {workLanes.map((item) => (
        <li
          class:list={[
            'tl-item',
            `tl-${item.track}`,
            `tl-${item.lane}`,
            {
              'tl-end': anchorEnd(item.start),
              'tl-ongoing': item.ongoing,
              'tl-clipped': item.clipped,
            },
          ]}
          style={`--s: ${item.start + 1}; --e: ${item.end + 1}`}
        >
          <span class="tl-bar" aria-hidden="true" />
          <span class="tl-label">
            <strong>{item.org}</strong>
            <span>{item.title}</span>
          </span>
          <span class="tl-period">{item.period}</span>
        </li>
      ))}
      <li class="tl-caption tl-caption-work" aria-hidden="true">
        work
      </li>
      <li class="tl-caption tl-caption-study" aria-hidden="true">
        study
      </li>
      <li class="tl-axis" style={`--n: ${presentMonth + 1}`} aria-hidden="true">
        {years.map((year) => (
          <span>{year}</span>
        ))}
      </li>
      <li class="tl-now" style={`--n: ${presentMonth + 1}`} aria-hidden="true"></li>
      {studyItems.map((item) => (
        <li
          class:list={[
            'tl-item',
            'tl-study',
            `tl-${item.track}`,
            {
              'tl-end': anchorEnd(item.start),
              'tl-ongoing': item.ongoing,
              'tl-clipped': item.clipped,
            },
          ]}
          style={`--s: ${item.start + 1}; --e: ${item.end + 1}`}
        >
          <span class="tl-bar" aria-hidden="true" />
          <span class="tl-label">
            <strong>{item.title}</strong>
            <span>{item.org}</span>
          </span>
          <span class="tl-period">{item.period}</span>
        </li>
      ))}
    </ol>
    <ol class="timeline-list" aria-label="Work and study, newest first">
      {timeline.map((item) => (
        <li class:list={['tl-row', `tl-${item.track}`]}>
          <span class="tl-period">{item.period}</span>
          <span class="tl-label">
            <strong>{item.row === 'work' ? item.org : item.title}</strong>
            <span>{item.row === 'work' ? item.title : item.org}</span>
          </span>
        </li>
      ))}
    </ol>
    {earlier.length > 0 && (
      <p class="timeline-earlier">
        Before {firstYear}: {earlierSentence}. The <a href="/cv/">CV</a> has the detail.
      </p>
    )}
  </section>

  <section class="wrap section-space experience" aria-labelledby="experience-title">
    <div class="section-heading">
      <h2 id="experience-title">Recent work.</h2>
      <a class="text-link" href="/cv/#experience">
        Full CV <Arrow />
      </a>
    </div>
    <div class="experience-list">
      {recentRoles.map((role) => (
        <article class="experience-row">
          <div class="experience-meta">
            <h3>{role.company}</h3>
            <p class="role-title">
              {role.titles.map((title, i) => (
                <Fragment>
                  {i > 0 && (
                    <Fragment>
                      <Arrow direction="up" />
                      <span class="sr-only">promoted from</span>
                    </Fragment>
                  )}
                  <span class="role-step">{title}</span>
                </Fragment>
              ))}
            </p>
            <p class="experience-date">{role.period}</p>
            <p class="experience-place">{role.location}</p>
          </div>
          <div class="experience-body">
            {role.highlights && (
              <ul class="experience-description">
                {role.highlights.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
            {role.tech.length > 0 && (
              <ul class="tech-labels" aria-label="Technologies">
                {role.tech.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section-space education" aria-labelledby="education-title">
    <div class="section-heading">
      <h2 id="education-title">Education.</h2>
    </div>
    <div class="experience-list">
      {education.map((item) => (
        <article class="experience-row">
          <div class="experience-meta">
            <h3>{item.degree}</h3>
            <p class="role-title">{item.school}</p>
            <p class="experience-date">{item.period}</p>
          </div>
          <div class="experience-body">
            {item.highlights && (
              <ul class="experience-description">
                {item.highlights.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
            {item.topics && (
              <ul class="tech-labels" aria-label="Subjects">
                {item.topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap beyond section-grid" aria-labelledby="beyond-title">
    <h2 id="beyond-title">Away from the keyboard.</h2>
    <div>
      <p class="beyond-copy">
        A mountain trail, somewhere new to explore, or a Lindy hop dance floor. There’s plenty to be
        curious about away from a screen.
      </p>
      <ul class="interests">
        {interests.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact-section" aria-labelledby="contact-title">
    <div class="wrap contact-inner">
      <h2 id="contact-title">
        If you’d like to talk,
        <br />
        write to me.
      </h2>
      <a class="contact-email" href={`mailto:${site.email}`}>
        {site.email} <Arrow direction="out" />
      </a>
    </div>
  </section>
</Base>
